{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evaluation case",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "case_id": {
      "type": "string"
    },
    "family": {
      "type": "string"
    },
    "prompt": {
      "type": "string"
    },
    "expected_key_points": {
      "type": "array"
    },
    "prohibited_errors": {
      "type": "array"
    },
    "bootstrap_executable": {
      "type": "boolean"
    }
  },
  "required": [
    "case_id",
    "family",
    "prompt",
    "expected_key_points",
    "prohibited_errors",
    "bootstrap_executable"
  ]
}
