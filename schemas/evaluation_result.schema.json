{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evaluation result",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "case_id": {
      "type": "string"
    },
    "model_id": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "score": {
      "type": [
        "number",
        "null"
      ]
    },
    "reviewer": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "case_id",
    "model_id",
    "status"
  ]
}
