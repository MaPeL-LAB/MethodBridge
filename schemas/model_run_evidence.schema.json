{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://github.com/MaPeL-LAB/MethodBridge/schemas/model_run_evidence.schema.json","title":"Shareable MethodBridge local real-model run evidence","type":"object","additionalProperties":false,"required":["schema_version","run_id","campaign_id","evidence_class","model_executed","measured","eligible_for_model_selection","eligible_for_submission_score","source_commit","candidate","artifact","runtime","benchmark","host","timestamps","outputs","semantic_review_status","limitations"],"properties":{"schema_version":{"const":1},"run_id":{"type":"string","pattern":"^[a-zA-Z0-9._-]+$"},"campaign_id":{"type":"string","minLength":5},"evidence_class":{"const":"local_real_model_output"},"model_executed":{"const":true},"measured":{"const":true},"eligible_for_model_selection":{"const":false},"eligible_for_submission_score":{"const":false},"source_commit":{"type":"string","pattern":"^[0-9a-f]{40}$"},"candidate":{"type":"object","additionalProperties":false,"required":["candidate_id","repository","revision","license_identifier"],"properties":{"candidate_id":{"type":"string"},"repository":{"type":"string","pattern":"^[^/]+/[^/]+$"},"revision":{"type":"string","pattern":"^[0-9a-f]{40}$"},"license_identifier":{"type":"string","minLength":2}}},"artifact":{"type":"object","additionalProperties":false,"required":["gguf_sha256","byte_size","quantization","local_path_exported"],"properties":{"gguf_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"byte_size":{"type":"integer","minimum":1},"quantization":{"type":"string","minLength":2},"local_path_exported":{"const":false}}},"runtime":{"type":"object","additionalProperties":false,"required":["executor","llama_cpp_commit","prompt_template","mode","configuration_sha256","command_exported"],"properties":{"executor":{"const":"llama.cpp"},"llama_cpp_commit":{"type":"string","pattern":"^[0-9a-f]{40}$"},"prompt_template":{"const":"chatml"},"mode":{"enum":["native","contract","mode_c"]},"configuration_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"command_exported":{"const":false}}},"benchmark":{"type":"object","additionalProperties":false,"required":["freeze_id","aggregate_sha256","case_count"],"properties":{"freeze_id":{"type":"string"},"aggregate_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"case_count":{"const":60}}},"host":{"type":"object","additionalProperties":false,"required":["measurement_class","attestation_sha256","eligible_for_submission_score"],"properties":{"measurement_class":{"enum":["simulation_only","reference_match"]},"attestation_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"eligible_for_submission_score":{"const":false}}},"timestamps":{"type":"object","additionalProperties":false,"required":["started_at","finished_at"],"properties":{"started_at":{"type":"string","format":"date-time"},"finished_at":{"type":"string","format":"date-time"}}},"outputs":{"type":"object","additionalProperties":false,"required":["raw_bundle_sha256","response_manifest_sha256","raw_text_exported","prompt_text_exported","response_text_exported"],"properties":{"raw_bundle_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"response_manifest_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"raw_text_exported":{"const":false},"prompt_text_exported":{"const":false},"response_text_exported":{"const":false}}},"semantic_review_status":{"enum":["pending","in_progress","completed","rejected"]},"limitations":{"type":"array","minItems":1,"items":{"type":"string","minLength":5}}}}
